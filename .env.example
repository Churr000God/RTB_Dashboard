# URL publica del callback de n8n al dashboard (solo si usas el flow async con coordinator)
RTB_CALLBACK_URL=http://localhost:8000/api/actualizaciones/finalizar

# Token compartido para autenticar callbacks de n8n
RTB_CALLBACK_TOKEN=cambiar-en-produccion

# Cuanto espera el dashboard a que aparezca un CSV nuevo en data/ despues
# de que n8n responde {"ok": true}. Total = ATTEMPTS * DELAY_SECONDS.
# Sube ATTEMPTS si tu sync de Nextcloud tarda mas de 5 minutos.
RTB_CSV_WAIT_ATTEMPTS=300
RTB_CSV_WAIT_DELAY_SECONDS=1.0
